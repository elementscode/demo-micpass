import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";

<BrandMark>
  <span class="brand-mark" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="2.5" width="6" height="11" rx="3"/>
      <path d="M5.5 11a6.5 6.5 0 0 0 13 0"/>
      <path d="M12 17.5V21"/>
    </svg>
  </span>
</BrandMark>

<Layout (title: string, width: string = "is-form")>
  <head>
    <title>{title ? `${title} · micpass` : "micpass"}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <header class="layout-header">
        <div class={["page-shell", width, "row", "layout-header-inner"]}>
          <a href="/" class="brand row">
            <BrandMark />
            micpass
          </a>
          <div class="cluster is-sm">
            <slot name="nav"/>
          </div>
        </div>
      </header>
      <main class={["page-shell", width, "layout-main"]}>
        <slot/>
      </main>
    </div>
  </body>
</Layout>
