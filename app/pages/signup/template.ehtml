import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/host");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <Layout title="Create a host account">
    <form class="auth stack is-lg" onsubmit={() => onSubmit(form)}>
      <div class="stack is-xs">
        <h1>Create a host account</h1>
        <p class="hint">Your audience never needs one.</p>
      </div>

      <p e:if={form.error} class="error" role="alert">{form.error}</p>

      <div class="stack">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" value={form.name} autocomplete="name" required>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email"
                 name="email"
                 type="email"
                 value={form.email}
                 autocomplete="email"
                 autocapitalize="none"
                 spellcheck={false}
                 placeholder="you@example.com"
                 required>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input id="password"
                 name="password"
                 type="password"
                 value={form.password}
                 autocomplete="new-password"
                 minlength={MIN_PASSWORD}
                 required>
          <p class="hint">At least {MIN_PASSWORD} characters.</p>
        </div>
      </div>

      <button type="submit" class="is-primary is-block">Create account</button>

      <p class="hint">Have an account? <a href="/signin" class="link-action">Sign in</a></p>
    </form>
  </Layout>
</html>
