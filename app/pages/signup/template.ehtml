import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Alert } from "@elements/ui/alert";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/host");
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <Layout title="Create a host account">
    <form class="auth stack is-lg" onsubmit={() => onSubmit(form)}>
      <div class="stack is-xs">
        <h1>Create a host account</h1>
        <p class="hint">Your audience never needs one.</p>
      </div>

      <Alert e:if={form.error} variant="danger" description={form.error} />

      <div class="stack">
        <Field label="Name" name="name">
          <Input value={form.name} required attrs={{ autocomplete: "name" }} />
        </Field>

        <Field label="Email" name="email">
          <Input type="email"
                 value={form.email}
                 placeholder="you@example.com"
                 required
                 attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
        </Field>

        <Field label="Password" name="password" description={`At least ${MIN_PASSWORD} characters.`}>
          <Input type="password"
                 value={form.password}
                 required
                 attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
        </Field>
      </div>

      <Button type="submit" variant="primary" block>Create account</Button>

      <p class="hint">Have an account? <a href="/signin" class="link-action">Sign in</a></p>
    </form>
  </Layout>
</html>
