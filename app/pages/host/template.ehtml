import "./style.css";
import { redirect, session } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signout } from "#app/shared/services/auth";
import { createEvent, EventForm } from "#app/shared/services/events";
import { plural } from "#app/shared/services/format";
import { Button } from "@elements/ui/button";
import { Badge } from "@elements/ui/badge";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Checkbox } from "@elements/ui/checkbox";
import { Label } from "@elements/ui/label";
import { Alert } from "@elements/ui/alert";
import { Empty } from "@elements/ui/empty";

export interface EventSummary {
  id: string;
  title: string;
  code: string;
  createdAt: Date;
  questionCount: number;
  pollCount: number;
}

function onCreate(form: EventForm) {
  try {
    createEvent(form);
    form.error = "";
  } catch (err: any) {
    form.error = err.message;
  }
}

function onSignout() {
  signout();
  redirect("/signin");
}

function formatDate(d: Date): string {
  return new Date(d).toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
}

<HostNav>
  <nav class="cluster is-sm">
    <span class="hint">{session.get("userName")}</span>
    <Button size="sm" variant="ghost" onclick={() => onSignout()}>Sign out</Button>
  </nav>
</HostNav>

<html lang="en" class="page-host" (
  events: EventSummary[],
  private form: EventForm = { title: "", moderated: true, error: "" },
)>
  <Layout title="Your events">
    <HostNav slot="nav" />

    <div class="stack is-xl">
      <div class="host-head row">
        <div class="stack is-xs">
          <p class="eyebrow">Host</p>
          <h1>Your events</h1>
        </div>
      </div>

      <Card title="New event" level={2}>
        <CardContent>
          <form class="stack" onsubmit={() => onCreate(form)}>
            <div class="create-form cluster">
              <Field label="Name" name="title" reserveError={false}>
                <Input value={form.title} placeholder="Friday all-hands" required />
              </Field>
              <Button type="submit" variant="primary">Create event</Button>
            </div>
            <Label class="check-row">
              <Checkbox checked={form.moderated} />
              Review questions before the audience sees them
            </Label>
            <Alert e:if={form.error} variant="danger" description={form.error} />
          </form>
        </CardContent>
      </Card>

      <Card>
        <div class="event-list">
          <a e:for={e of events} href={`/host/events/${e.id}`} class="event-link">
            <span class="stack is-xs">
              <span class="event-title">{e.title}</span>
              <span class="event-meta">{formatDate(e.createdAt)} · {plural(e.questionCount, "question")} · {plural(e.pollCount, "poll")}</span>
            </span>
            <Badge variant="secondary" class="event-code">{e.code}</Badge>
          </a>
          <Empty e:if={events.length === 0} description="No events yet. Create one above and share its code." />
        </div>
      </Card>
    </div>
  </Layout>
</html>
