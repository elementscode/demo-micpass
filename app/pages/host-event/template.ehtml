import "./style.css";
import { LiveView } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { PollBars, WordCloud } from "#app/shared/templates/poll-results";
import {
  MicEvent,
  Question,
  QuestionStatus,
  QuestionVote,
  Poll,
  PollKind,
  PollResponse,
  rankQuestions,
  voteCounts,
  tallyChoices,
  tallyWords,
  responseCount,
} from "#app/shared/services/live";
import { timeAgo, plural } from "#app/shared/services/format";
import { Button } from "@elements/ui/button";
import { Badge } from "@elements/ui/badge";
import { Card, CardHeader, CardTitle, CardDescription, CardAction, CardContent, CardFooter } from "@elements/ui/card";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@elements/ui/tabs";
import { Switch } from "@elements/ui/switch";
import { Label } from "@elements/ui/label";
import { ToggleGroup, ToggleGroupItem, type ChangeDetails } from "@elements/ui/toggle-group";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Alert } from "@elements/ui/alert";
import { Empty } from "@elements/ui/empty";
import { Icon } from "@elements/ui/icon";

type Filter = "review" | "live" | "answered" | "hidden";

interface ConsoleState {
  filter: Filter;
}

interface OptionDraft {
  id: string;
  text: string;
}

interface PollForm {
  prompt: string;
  kind: PollKind;
  options: OptionDraft[];
  error: string;
}

function blankOptions(): OptionDraft[] {
  return [0, 1, 2].map(() => ({ id: crypto.randomUUID(), text: "" }));
}

function blankPoll(): PollForm {
  return { prompt: "", kind: "choice", options: blankOptions(), error: "" };
}

function current(event: LiveView<MicEvent>): MicEvent {
  return event.at(0)!;
}

function inFilter(q: Question, filter: Filter): boolean {
  switch (filter) {
    case "review":
      return q.status === "pending";

    case "live":
      return q.status === "live" && !q.answered;

    case "answered":
      return q.status === "live" && q.answered;

    default:
      return q.status === "hidden";
  }
}

function filtered(questions: LiveView<Question>, votes: LiveView<QuestionVote>, filter: Filter): Question[] {
  let list = questions.filter((q) => inFilter(q, filter));

  if (filter === "review") {
    return list.sort((a, b) => +new Date(a.createdAt) - +new Date(b.createdAt));
  }

  return rankQuestions(list, voteCounts(votes));
}

function countIn(questions: LiveView<Question>, filter: Filter): number {
  return questions.filter((q) => inFilter(q, filter)).length;
}

function setStatus(questions: LiveView<Question>, q: Question, status: QuestionStatus) {
  questions.update({ ...q, status, pinned: status === "live" && q.pinned });
}

function onPin(questions: LiveView<Question>, q: Question) {
  if (q.pinned) {
    questions.update({ ...q, pinned: false });
    return;
  }

  for (let other of questions.filter((x) => x.pinned && x.id !== q.id)) {
    questions.update({ ...other, pinned: false });
  }

  questions.update({ ...q, pinned: true });
}

function onAnswered(questions: LiveView<Question>, q: Question) {
  questions.update({ ...q, answered: !q.answered, pinned: false });
}

function onModerated(event: LiveView<MicEvent>) {
  let ev = current(event);
  event.update({ ...ev, moderated: !ev.moderated });
}

function onFilter(state: ConsoleState, filter: string) {
  state.filter = filter as Filter;
}

function onKind(form: PollForm, kind: string, details: ChangeDetails) {
  if (!kind) {
    details.cancel();
    return;
  }

  form.kind = kind as PollKind;
}

function onAddOption(form: PollForm) {
  form.options.push({ id: crypto.randomUUID(), text: "" });
}

function onRemoveOption(form: PollForm, option: OptionDraft) {
  let i = form.options.indexOf(option);
  if (i >= 0 && form.options.length > 2) {
    form.options.splice(i, 1);
  }
}

function onCreatePoll(polls: LiveView<Poll>, form: PollForm, reset: () => void) {
  let prompt = form.prompt.trim();
  let options = form.options.map((o) => o.text.trim()).filter(Boolean);

  if (!prompt) {
    form.error = "Write the poll question.";
    return;
  }

  if (form.kind === "choice" && options.length < 2) {
    form.error = "Add at least two options.";
    return;
  }

  polls.insert({
    prompt,
    kind: form.kind,
    options: form.kind === "choice" ? options : [],
    status: "draft",
    createdAt: new Date(),
  }, reset);
}

function onOpenPoll(polls: LiveView<Poll>, event: LiveView<MicEvent>, poll: Poll) {
  for (let other of polls.filter((p) => p.status === "open" && p.id !== poll.id)) {
    polls.update({ ...other, status: "closed" });
  }

  polls.update({ ...poll, status: "open" });
  event.update({ ...current(event), showPollId: poll.id });
}

function onClosePoll(polls: LiveView<Poll>, poll: Poll) {
  polls.update({ ...poll, status: "closed" });
}

function onShow(event: LiveView<MicEvent>, pollId: string | null) {
  event.update({ ...current(event), showPollId: pollId });
}

function onDeletePoll(polls: LiveView<Poll>, event: LiveView<MicEvent>, poll: Poll) {
  if (current(event).showPollId === poll.id) {
    onShow(event, null);
  }

  polls.delete(poll);
}

function newestFirst(polls: LiveView<Poll>): Poll[] {
  let rank = { open: 0, draft: 1, closed: 2 };

  return polls.sort((a, b) => rank[a.status] - rank[b.status] || +new Date(b.createdAt) - +new Date(a.createdAt));
}

function statusVariant(poll: Poll): "success" | "secondary" | "info" {
  switch (poll.status) {
    case "open":
      return "success";

    case "draft":
      return "secondary";

    default:
      return "info";
  }
}

const FILTERS: { id: Filter, label: string }[] = [
  { id: "review", label: "Review" },
  { id: "live", label: "Live" },
  { id: "answered", label: "Answered" },
  { id: "hidden", label: "Hidden" },
];

function shownFilters(event: LiveView<MicEvent>, questions: LiveView<Question>): { id: Filter, label: string }[] {
  let review = current(event).moderated || countIn(questions, "review") > 0;

  return FILTERS.filter((f) => f.id !== "review" || review);
}

<QuestionRow (q: Question, questions: LiveView<Question>, votes: number)>
  <li class={["q", q.pinned && "is-pinned", q.answered && "is-done"]}>
    <div class="q-votes" title={plural(votes, "vote")}>
      <strong>{votes}</strong>
      votes
    </div>
    <div class="q-body stack is-xs">
      <p class="q-text">{q.body}</p>
      <div class="q-meta cluster is-xs">
        <span>{q.authorName || "Anonymous"} · {timeAgo(q.createdAt)}</span>
        <Badge e:if={q.pinned} variant="accent">Pinned</Badge>
        <Badge e:if={q.answered} variant="success">Answered</Badge>
      </div>
      <div class="q-actions cluster is-xs">
        <div e:if={q.status === "pending"} class="cluster is-xs">
          <Button size="sm" variant="primary" onclick={() => setStatus(questions, q, "live")}>Approve</Button>
          <Button size="sm" variant="ghost" onclick={() => setStatus(questions, q, "hidden")}>Hide</Button>
        </div>
        <div e:elseif={q.status === "live"} class="cluster is-xs">
          <Button e:if={!q.answered} size="sm" onclick={() => onPin(questions, q)}>{q.pinned ? "Unpin" : "Pin"}</Button>
          <Button size="sm" onclick={() => onAnswered(questions, q)}>{q.answered ? "Reopen" : "Mark answered"}</Button>
          <Button size="sm" variant="ghost" onclick={() => setStatus(questions, q, "hidden")}>Hide</Button>
        </div>
        <div e:else class="cluster is-xs">
          <Button size="sm" onclick={() => setStatus(questions, q, "live")}>Restore</Button>
        </div>
      </div>
    </div>
  </li>
</QuestionRow>

<PollCard (
  poll: Poll,
  polls: LiveView<Poll>,
  event: LiveView<MicEvent>,
  responses: LiveView<PollResponse>,
)>
  <Card class={poll.status === "open" ? "poll-card is-open" : "poll-card"}>
    <CardHeader>
      <CardTitle>{poll.prompt}</CardTitle>
      <CardDescription>{poll.kind === "words" ? "Word cloud" : "Multiple choice"} · {plural(responseCount(poll, responses), "response")}</CardDescription>
      <CardAction><Badge variant={statusVariant(poll)}>{poll.status}</Badge></CardAction>
    </CardHeader>
    <CardContent>
      <ol e:if={poll.status === "draft" && poll.kind === "choice"} class="poll-options">
        <li e:for={o of poll.options.map((text, i) => ({ id: String(i), text }))}>{o.text}</li>
      </ol>
      <p e:elseif={poll.status === "draft"} class="poll-sub">The audience answers with a word or two.</p>
      <PollBars e:elseif={poll.kind === "choice"} tallies={tallyChoices(poll, responses)} />
      <WordCloud e:else words={tallyWords(poll, responses)} />
    </CardContent>
    <CardFooter align="start">
      <Button e:if={poll.status !== "open"} size="sm" variant="primary" onclick={() => onOpenPoll(polls, event, poll)}>{poll.status === "draft" ? "Open poll" : "Reopen"}</Button>
      <Button e:else size="sm" variant="primary" onclick={() => onClosePoll(polls, poll)}>Close poll</Button>
      <span e:if={current(event).showPollId === poll.id} class="on-screen">On screen</span>
      <Button e:elseif={poll.status !== "draft"} size="sm" onclick={() => onShow(event, poll.id)}>Show on screen</Button>
      <Button e:if={poll.status === "draft"} size="sm" variant="ghost" onclick={() => onDeletePoll(polls, event, poll)}>Delete</Button>
    </CardFooter>
  </Card>
</PollCard>

<NewPoll (polls: LiveView<Poll>, private form: PollForm = blankPoll())>
  <form onsubmit={() => onCreatePoll(polls, form, () => form = blankPoll())}>
    <Card title="New poll" level={2}>
      <CardContent class="stack">
        <ToggleGroup type="single"
                     value={form.kind}
                     variant="outline"
                     size="sm"
                     spacing={0}
                     label="Poll type"
                     class="poll-kind"
                     onValueChange={(kind, details) => onKind(form, kind, details)}>
          <ToggleGroupItem value="choice">Multiple choice</ToggleGroupItem>
          <ToggleGroupItem value="words">Word cloud</ToggleGroupItem>
        </ToggleGroup>
        <Field label="Question" reserveError={false}>
          <Input value={form.prompt} placeholder={form.kind === "words" ? "One word for this quarter" : "Which should we build next?"} />
        </Field>
        <div e:if={form.kind === "choice"} class="stack is-sm">
          <div e:for={o of form.options} class="option-row row">
            <Input value={o.text} placeholder="Option" attrs={{ "aria-label": "Option" }} />
            <Button size="sm" variant="ghost" icon label="Remove option" onclick={() => onRemoveOption(form, o)}><Icon name="x" /></Button>
          </div>
          <div><Button size="sm" variant="ghost" onclick={() => onAddOption(form)}><Icon name="plus" /> Add option</Button></div>
        </div>
        <Alert e:if={form.error} variant="danger" description={form.error} />
      </CardContent>
      <CardFooter>
        <Button type="submit" size="sm" variant="primary">Save as draft</Button>
      </CardFooter>
    </Card>
  </form>
</NewPoll>

<html lang="en" class="page-host-event" (
  event: LiveView<MicEvent>,
  questions: LiveView<Question>,
  votes: LiveView<QuestionVote>,
  polls: LiveView<Poll>,
  responses: LiveView<PollResponse>,
  origin: string,
  private state: ConsoleState = { filter: "live" as Filter },
)>
  <Layout title={current(event).title} width="">
    <nav slot="nav" class="cluster is-sm console-nav">
      <Button href="/host" size="sm" variant="ghost">All events</Button>
      <Button href={`/e/${current(event).code}`} size="sm" attrs={{ target: "_blank", rel: "noopener" }}>Audience view</Button>
      <Button href={`/host/events/${current(event).id}/present`} size="sm" variant="primary" attrs={{ target: "_blank", rel: "noopener" }}>Presenter screen</Button>
    </nav>

    <div class="stack is-xl">
      <div class="console-head row">
        <div class="stack is-xs">
          <p class="eyebrow">Join at {origin}/e/{current(event).code}</p>
          <h1>{current(event).title}</h1>
        </div>
        <div class="cluster">
          <Badge variant="secondary" class="console-code">{current(event).code}</Badge>
          <Label class="check-row">
            <Switch checked={current(event).moderated} onCheckedChange={() => onModerated(event)} />
            Review before posting
          </Label>
        </div>
      </div>

      <div class="console-grid">
        <section>
          <Tabs value={state.filter} class="console-tabs" onValueChange={(f) => onFilter(state, f)}>
            <TabsList label="Questions">
              <TabsTrigger e:for={f of shownFilters(event, questions)} value={f.id}>
                {f.label}<span class="tab-count">{countIn(questions, f.id)}</span>
              </TabsTrigger>
            </TabsList>
            <TabsContent e:for={f of shownFilters(event, questions)} value={f.id}>
              <ul e:if={countIn(questions, f.id) > 0} class="q-list">
                <QuestionRow e:for={q of filtered(questions, votes, f.id)}
                             {q}
                             {questions}
                             votes={voteCounts(votes).get(q.id) ?? 0} />
              </ul>
              <Empty e:else
                     variant="outline"
                     description={f.id === "review" ? "Nothing waiting for review." : "No questions here yet."} />
            </TabsContent>
          </Tabs>
        </section>

        <aside class="console-side stack">
          <div class="side-head row">
            <h2>Polls</h2>
            <Button e:if={current(event).showPollId} size="sm" onclick={() => onShow(event, null)}>Show questions on screen</Button>
          </div>
          <div class="poll-list">
            <PollCard e:for={p of newestFirst(polls)} poll={p} {polls} {event} {responses} />
          </div>
          <NewPoll {polls} />
        </aside>
      </div>
    </div>
  </Layout>
</html>
