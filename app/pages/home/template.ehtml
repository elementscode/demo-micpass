import "./style.css";
import { redirect } from "@elements/app";
import { Layout, BrandMark } from "#app/shared/templates/layout";
import { findEvent } from "#app/shared/services/events";
import { Button } from "@elements/ui/button";
import { Input } from "@elements/ui/input";
import { Alert } from "@elements/ui/alert";

interface JoinForm {
  code: string;
  error: string;
}

function onSubmit(form: JoinForm) {
  try {
    let code = findEvent(form.code);
    form.error = "";
    redirect(`/e/${code}`);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-home" (
  signedIn: boolean,
  private form: JoinForm = { code: "", error: "" },
)>
  <Layout title="Join an event">
    <nav slot="nav" class="cluster is-sm">
      <Button e:if={signedIn} href="/host" size="sm">Your events</Button>
      <Button e:else href="/signin" size="sm" variant="ghost">Host sign in</Button>
    </nav>

    <section class="join stack is-xl">
      <div class="stack is-md">
        <p class="eyebrow">Live Q&amp;A and polls</p>
        <h1 class="join-title">Pass the <em>mic.</em></h1>
        <p class="lede">Enter the code on the screen to ask questions, upvote the ones you want answered, and vote in polls. No account needed.</p>
      </div>

      <form class="join-form stack" onsubmit={() => onSubmit(form)}>
        <label for="code" class="sr-only">Event code</label>
        <Input name="code"
               class="join-code"
               value={form.code}
               placeholder="CODE"
               invalid={!!form.error}
               required
               attrs={{ id: "code", maxlength: 10, autocomplete: "off", autocapitalize: "characters", spellcheck: "false" }} />
        <Alert e:if={form.error} variant="danger" description={form.error} />
        <Button type="submit" variant="primary" size="lg" block>Join</Button>
      </form>

      <p class="join-host">Running a talk? <a href="/signin" class="link-action">Host an event</a></p>
    </section>
  </Layout>
</html>
