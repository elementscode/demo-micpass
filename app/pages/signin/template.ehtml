import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signin } from "#app/shared/services/auth";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Alert, AlertTitle, AlertDescription } from "@elements/ui/alert";

export const DEMO_EMAIL = "host@micpass.dev";

export const DEMO_PASSWORD = "micpass-demo";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm) {
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/host");
  } catch (err: any) {
    form.error = err.message;
  }
}

function onUseDemo(form: SigninForm) {
  form.email = DEMO_EMAIL;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <Layout title="Host sign in">
    <div class="auth stack is-lg">
      <div class="stack is-xs">
        <h1>Host sign in</h1>
        <p class="hint">Run Q&amp;A and polls for your talks and meetings.</p>
      </div>

      <Alert variant="accent" role="none" class="auth-demo">
        <AlertTitle>Demo host</AlertTitle>
        <AlertDescription class="stack is-sm">
          <p>Email <code>{DEMO_EMAIL}</code><br>Password <code>{DEMO_PASSWORD}</code></p>
          <div><Button size="sm" onclick={() => onUseDemo(form)}>Sign in as demo host</Button></div>
        </AlertDescription>
      </Alert>

      <form class="stack" onsubmit={() => onSubmit(form)}>
        <Alert e:if={form.error} variant="danger" description={form.error} />

        <Field label="Email" name="email">
          <Input type="email"
                 value={form.email}
                 placeholder="you@example.com"
                 required
                 attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
        </Field>

        <Field label="Password" name="password">
          <Input type="password"
                 value={form.password}
                 required
                 attrs={{ autocomplete: "current-password" }} />
        </Field>

        <Button type="submit" variant="primary" block>Sign in</Button>

        <p class="hint">New here? <a href="/signup" class="link-action">Create a host account</a></p>
      </form>
    </div>
  </Layout>
</html>
